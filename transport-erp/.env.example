# PostgreSQL connection
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/grl_erp"
# Long random secret for sessions (64+ characters). Never share it.
AUTH_SECRET="change-me-to-a-long-random-string"
PORT=4000
HOST=0.0.0.0
# true only when the ERP is served over HTTPS (reverse proxy)
COOKIE_SECURE=false
# Optional: full path to pg_dump for native database backups (auto-detected on Windows)
PG_DUMP_PATH=
# Optional: where backups go (default: Documents/G Road Lines ERP/Backup)
# BACKUP_ROOT=
# Optional: maximum upload size in MB
MAX_UPLOAD_MB=10
