# ---------------------------------------------------------------
# Waste Management ERP - environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://erp:CHANGE_ME@localhost:5432/waste_erp?schema=public"

# Secret used to sign session tokens. Generate with:  openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Session lifetime in hours (default 12)
SESSION_HOURS=12

# Set to "true" when served over HTTPS so cookies are marked Secure
COOKIE_SECURE=false

# Business timezone used for "today", day ranges and printed times
APP_TIMEZONE="Asia/Kolkata"

# Directory where uploaded documents/photos are stored (must be writable and backed up)
UPLOAD_DIR="./storage/uploads"

# Maximum upload size in MB
MAX_UPLOAD_MB=10

# Initial admin password used ONLY by the seed script (prisma/seed.ts).
# Change the password after first login.
SEED_ADMIN_PASSWORD="CHANGE_ME_Admin@123"
# Password given to the demo users created by the seed (ops, weigh, process, sales, accounts, mgmt)
SEED_DEMO_PASSWORD="CHANGE_ME_Demo@123"

# Optional SMTP settings for emailing invoices. Leave SMTP_HOST empty to disable email.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Accounts <accounts@example.com>"
POSTGRES_PASSWORD="CHANGE_ME"   # used by docker-compose.yml only
